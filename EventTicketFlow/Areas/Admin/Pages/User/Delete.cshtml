@page
@model EventTicketFlow.Areas.Admin.Pages.User.DeleteModel
@{
    ViewData["Title"] = "Delete user";
}
<section class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-semibold">Delete user</h1>
    <p class="text-(--text-muted)">Are you sure you want to delete this user?</p>
    <div asp-validation-summary="ModelOnly" class="my-4 text-sm text-red-300" role="alert"></div>
    <dl class="grid gap-x-6 gap-y-3 border-t border-(--border-color) pt-6 md:grid-cols-[12rem_1fr] [&_dt]:font-medium [&_dt]:text-(--text-muted) [&_dd]:m-0 [&_dd]:break-words">
        <dt>Username</dt><dd>@Model.UserDetails.UserName</dd>
        <dt>Email</dt><dd>@Model.UserDetails.Email</dd>
        <dt>Phone number</dt><dd>@(string.IsNullOrEmpty(Model.UserDetails.PhoneNumber) ? "—" : Model.UserDetails.PhoneNumber)</dd>
    </dl>
    <form method="post" class="mt-8 flex flex-wrap items-center gap-4 border-t border-(--border-color) pt-6">
        <input type="hidden" asp-for="Id" />
        <button type="submit" disabled="@(Model.IsCurrentUser || Model.IsLastAdmin)" class="cursor-pointer rounded border-0 bg-red-700 px-5 py-2 font-semibold text-white hover:bg-red-600 disabled:cursor-not-allowed disabled:opacity-50">Delete user</button>
        <a asp-page="./Index" class="text-sm text-(--text-muted) hover:text-(--text-main)">Cancel</a>
    </form>
</section>
