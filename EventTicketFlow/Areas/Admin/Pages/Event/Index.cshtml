@page
@model EventTicketFlow.Pages.EventPages.IndexModel

@{
    ViewData["Title"] = "Events";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="m-0 text-2xl font-semibold">Events</h1>
    <a asp-page="Create"
       class="rounded bg-(--primary-color) px-5 py-2 font-semibold text-white no-underline hover:bg-(--primary-hover)">Create
        event</a>
    </div>
    <form method="get" class="mb-6 flex flex-wrap items-center gap-4" role="search">
        <label for="search" class="font-medium">Search events</label>
        <input id="search" name="search" type="search" value="@Model.Search" placeholder="Search by event name"
               class="rounded border border-(--border-color) bg-(--bg-card) px-3 py-2 text-(--text-main)" />
        <button type="submit"
                class="cursor-pointer rounded border-0 bg-(--primary-color) px-5 py-2 font-semibold text-white">Search</button>
    </form>
    <div class="overflow-x-auto border-t border-(--border-color)">
        <table
            class="w-full border-collapse text-left text-sm [&_th]:border-b [&_th]:border-(--border-color) [&_th]:px-3 [&_th]:py-3 [&_th]:font-medium [&_th]:text-(--text-muted) [&_td]:border-b [&_td]:border-(--border-color) [&_td]:px-3 [&_td]:py-3 [&_a]:text-blue-300 [&_a:hover]:text-white">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Event[0].EventName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Event[0].MaxTickets)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Event[0].OpenDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Event[0].CloseDate)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Event)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(model => item.EventName)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.MaxTickets)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.OpenDate)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.CloseDate)
                        </td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-page="./CheckIn" asp-route-id="@item.Id">Check in</a> |
                            <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
                @if (Model.Event.Count == 0)
                {
                    <tr>
                        <td colspan="5">No events found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav aria-label="Event pages" class="mt-6 flex flex-wrap items-center gap-4">
        @if (Model.CurrentPage > 1)
        {
            <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
        }
        <span>Page @Model.CurrentPage of @Model.TotalPages</span>
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
        }
    </nav>
