@page
@model EventTicketFlow.Pages.EventPages.DetailsModel

@{
    ViewData["Title"] = "Details for \"" + Model.Event.EventName + "\"";
}

<section class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-semibold">Event details</h1>
    <h2 class="text-lg text-(--text-muted)">@Model.Event.EventName</h2>
    <section aria-labelledby="sales-heading" class="mt-6 border-t border-(--border-color) pt-6">
        <h2 id="sales-heading" class="text-lg font-semibold">Ticket sales</h2>
        <dl class="grid gap-x-6 gap-y-3 md:grid-cols-[12rem_1fr] [&_dt]:font-medium [&_dt]:text-(--text-muted) [&_dd]:m-0">
            <dt>Tickets sold</dt><dd>@Model.TicketsSold</dd>
            <dt>Tickets remaining</dt><dd>@Model.TicketsRemaining</dd>
            <dt>Total revenue</dt><dd>@Model.Revenue.ToString("C")</dd>
        </dl>
        <h3 class="mt-6 font-semibold">Tickets sold over time</h3>
        @if (Model.Sales.Count == 0)
        {
            <p>No ticket sales yet.</p>
        }
        else
        {
            var maxSales = Model.Sales.Max(day => day.Quantity);
            <table class="w-full text-left text-sm">
                <thead><tr><th>Date</th><th>Tickets sold</th><th>Revenue</th></tr></thead>
                <tbody>
                @foreach (var day in Model.Sales)
                {
                    <tr>
                        <td>@day.Date.ToString("d")</td>
                        <td>
                            <span>@day.Quantity</span>
                            <span aria-hidden="true" style="display:block; height:0.5rem; width:@(maxSales > 0 ? (int)(100L * day.Quantity / maxSales) : 0)%; background:var(--primary-color)"></span>
                        </td>
                        <td>@day.Revenue.ToString("C")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
    <dl class="grid gap-x-6 gap-y-3 border-t border-(--border-color) pt-6 md:grid-cols-[12rem_1fr] [&_dt]:font-medium [&_dt]:text-(--text-muted) [&_dd]:m-0 [&_dd]:break-words">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.EventName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.EventName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.EventDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.EventDescription)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.EventCreated)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.EventCreated)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.OpenDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.OpenDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.CloseDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.CloseDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.MaxTickets)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.MaxTickets)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event.CreatedBy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.CreatedBy)
        </dd>
    </dl>
    <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-(--border-color) pt-6">
        <a asp-page="./Edit" asp-route-id="@Model.Event.Id" class="rounded bg-(--primary-color) px-5 py-2 font-semibold text-white no-underline hover:bg-(--primary-hover)">Edit event</a>
        <a href="@Url.Content($"~/Event/{Model.Event.Id}")" target="_blank" rel="noopener noreferrer">View public event (opens in a new tab)</a>
        <a asp-page="./Index" class="text-sm text-(--text-muted) hover:text-(--text-main)">Back to events</a>
    </div>
</section>
