@page
@model EventTicketFlow.Pages.EventPages.CreateModel

@{
    ViewData["Title"] = "Create event";
}

<section class="mx-auto max-w-3xl">
    <a asp-page="./Index" class="text-sm font-medium text-(--text-muted) hover:text-(--text-main)">&larr; Back to events</a>
    <h1 class="mt-5 mb-1 text-2xl font-semibold">Create event</h1>
    <form method="post" class="mt-6 border-t border-(--border-color) pt-6">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-300" role="alert"></div>
        <partial name="_EventFields" for="Event" />
        <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-(--border-color) pt-6 md:pl-48">
            <button type="submit" class="cursor-pointer rounded border-0 bg-(--primary-color) px-5 py-2 font-semibold text-white hover:bg-(--primary-hover) focus:outline-2 focus:outline-offset-2 focus:outline-(--primary-color)">Create event</button>
            <a asp-page="./Index" class="text-sm font-medium text-(--text-muted) hover:text-(--text-main)">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
