@page
@model EventTicketFlow.Pages.EventPages.DeleteModel

@{
    ViewData["Title"] = "Delete Event \"" + Model.Event.EventName + "\"";
}

<section class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-semibold">Delete event</h1>
    <p class="text-(--text-muted)">Are you sure you want to delete this event?</p>
    <dl
        class="grid gap-x-6 gap-y-3 border-t border-(--border-color) pt-6 md:grid-cols-[12rem_1fr] [&_dt]:font-medium [&_dt]:text-(--text-muted) [&_dd]:m-0 [&_dd]:break-words">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.CreatedBy)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.CreatedBy)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.EventName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.EventName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.EventDescription)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.EventDescription)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.EventCreated)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.EventCreated)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.OpenDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.OpenDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.CloseDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.CloseDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.MaxTickets)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.MaxTickets)
        </dd>
    </dl>
    <form method="post" asp-route-id="@Model.Event.Id"
          class="mt-8 flex flex-wrap items-center gap-4 border-t border-(--border-color) pt-6">
        <input type="hidden" asp-for="Event.Id" />
        <button type="submit"
                class="cursor-pointer rounded border-0 bg-red-700 px-5 py-2 font-semibold text-white hover:bg-red-600">Delete
            event
        </button>
        <a asp-page="./Index" class="text-sm text-(--text-muted) hover:text-(--text-main)">Cancel</a>
    </form>
</section>
