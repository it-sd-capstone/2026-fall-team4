@model EventTicketFlow.Models.Event

@{
    ViewData["Title"] = Model.EventName;

    // Get TicketType record passed from the controller
    var ticketType = ViewBag.TicketType as TicketType;
    int ticketsSold = ViewBag.TicketsSold ?? 0;
    int ticketsRemaining = ViewBag.TicketsRemaining ?? 0;
}

@section Styles
{
    <link rel="stylesheet"href="~/css/event-details.css"asp-append-version="true" />
}

<!-- Event header -->

<div class="event-details-page">

    <div class="page-links">
        <a asp-controller="Home"
           asp-action="Index">← Back to Events</a>
    </div>

    <div class="event-header">

        <h1>@Model.EventName</h1>

        <div class="event-date-range">
            Event Start @Model.OpenDate.ToString("MMMM dd, yyyy h:mm tt")
            &nbsp;&nbsp;|&nbsp;&nbsp; 
            Event End @Model.CloseDate.ToString("MMMM dd, yyyy h:mm tt")
        </div>

    </div>

    <div class="event-hero">
        <div class="event-image-placeholder">Event Image</div>
    </div>

    <div class="event-details-grid">

        <!-- Left Side -->

        <section class="event-information">

            <h2>Event Description</h2>

            <p>@Model.EventDescription</p>

            <hr />

            <h3>Additional Information</h3>

            <div class="detail-row">
                <span class="detail-label">Maximum Capacity</span>
                <span>@Model.MaxTickets</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Tickets Sold</span>
                <span>@ticketsSold</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Tickets Remaining</span>
                <span>@ticketsRemaining</span>
            </div>

        </section>

        <!-- Right Side -->

        <aside class="ticket-panel">

            <h2>Tickets</h2>

            <form asp-controller="Checkout" 
                  asp-action="Index"
                  method="post"
                  id="purchaseForm">
              
                  <input type="hidden" name="EventId" value="@Model.Id" />
                  <input type="hidden" name="DiscountCode" id="appliedDiscountCode" />
                  
              

            <div class="ticket-option">

                <p class="ticket-option-title">Quantity</p>

                <input id="quantity" name="Quantity" class="ticket-price" type="number" min="0" max="@ticketsRemaining" value="0" step="1" inputmode="numeric"/>

            </div>

            <div class="ticket-option">
                <p class="ticket-option-title">General Admission</p>
                <p class="ticket-price">@ticketType?.GeneralPrice.ToString("C")</p>
            </div>

            <div class="ticket-addon">
            <div class="ticket-option">
                <input type="checkbox"id="vipCheckbox" name="IsVip" value="true"
                       aria-describedby="vipHelp"/>

                <p class="ticket-option-title">VIP Access</p>
                <p class="ticket-price">(+@ticketType?.VipPrice.ToString("C") per ticket)</p>
            </div>
                <p id="vipHelp" class="ticket-option-help">
                    This option grants VIP entrance's and has a premium viewing/seating seciton!
                </p>
            </div>

            <div class="ticket-addon">
            <div class="ticket-option">
                <input type="checkbox" id="fastTrackCheckbox" name="IsFastTrack" value="true" 
                       aria-describedby="fastTrackHelp"/>
                <p class ="ticket-option-title">Fast Track</p>
                <p class="ticket-price">(+@ticketType?.FastTrackPrice.ToString("C") per ticket)</p>
            </div>
                <p id="fastTrackHelp" class="ticket-option-help">
                    This option allows you to skip the regular lines for the main event and for any consessions!
                </p>
            </div>

            <div class="discount-option">
                <label for="discountCode" class="ticket-option-title">Discount Code</label>

                <div class="discount-row">
                    <input id="discountCode" type="text" maxlength="50" autocomplete="off" placeholder="Enter code" />
                    <button type="button" id="applyDiscountButton">Apply</button>
                </div>

                <p id="discountMessage" class="discount-message" aria-live="polite"></p>
            </div>

            <hr />

            <div class="ticket-option" id="discountRow" hidden>
                <span>Discount (<span id="discountPercent"></span>%)</span>
                <span id="discountAmount"></span>
            </div>

            <div class="ticket-option">
                <span>Total Cost</span>
                <span id="totalCost">@ticketType?.GeneralPrice.ToString("C")</span>

            </div>

                <button type="submit" id="purchaseButton" class="purchase-button">Purchase Tickets</button>

            </form>

        </aside>

    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("EventManager"))
    {
        <div class="page-links">
        <a asp-area="Admin"
           asp-page="/Event/Edit"
           asp-route-id="@Model.Id">Edit Event</a>
        </div>
    }

</div>

@section Scripts
{
    <script>

        // map variables from view
        const quantityInput = document.getElementById('quantity');
        const vipCheckbox = document.getElementById('vipCheckbox');
        const fastTrackCheckbox = document.getElementById('fastTrackCheckbox');
        const totalCost = document.getElementById('totalCost');
        const purchaseButton = document.getElementById('purchaseButton');

        // map discount variables from view
        const discountInput = document.getElementById('discountCode');
        const applyDiscountButton = document.getElementById('applyDiscountButton');
        const discountMessage = document.getElementById('discountMessage');
        const discountRow = document.getElementById('discountRow');
        const discountPercent = document.getElementById('discountPercent');
        const discountAmountText = document.getElementById('discountAmount');
        const appliedDiscountInput = document.getElementById('appliedDiscountCode');

        // Percent off from the last code that passed the check (0 = none)
        let percentOff = 0;
        const ticketsRemaining = @ticketsRemaining;

        // map prices for each ticket option
        const basePrice = @((ticketType?.GeneralPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const vipPrice = @((ticketType?.VipPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const fastTrackPrice = @((ticketType?.FastTrackPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));

        // fucntion to calculate total price, track quantity that can be purchased, and adjust purchase button state
        function calculateTotal()
        {
            let quantity = parseInt(quantityInput.value) || 0;

            // Prevent quantity from going higher than available when typed
            if (quantity > ticketsRemaining) 
            {
                quantity = ticketsRemaining;
                quantityInput.value = ticketsRemaining;
            }

            // Prevent negative quantities to be typed in
            if (quantity < 0)
            {
                quantity = 0;
                quantityInput.value = 0;
            }

            // Calculate total based on selections
            let ticketPrice = basePrice;

            if (vipCheckbox.checked)
            {
                ticketPrice += vipPrice;
            }

            if (fastTrackCheckbox.checked)
            {
                ticketPrice += fastTrackPrice;
            }

            let total = ticketPrice * quantity;

            // Take the discount off if a code has been applied
            if (percentOff > 0) 
            {
                let discountAmount = total * percentOff / 100;
                total = total - discountAmount;

                discountPercent.innerText = percentOff;
                discountAmountText.innerText = '-$' + discountAmount.toFixed(2);
                discountRow.hidden = false;
            }
            else 
            {
                discountRow.hidden = true;
            }

            totalCost.innerText = '$' + total.toFixed(2);

            // Purchase button state management
            if (ticketsRemaining <= 0)
            {
                purchaseButton.disabled = true;
                purchaseButton.textContent = 'Sold Out';
                purchaseButton?.classList.add('sold-out-button');
                purchaseButton.classList.remove('quantity-required-button');
            }
            else if (quantity < 1)
            {
                purchaseButton.disabled = true;
                purchaseButton.textContent = 'Select Quantity';
                purchaseButton.classList.remove('sold-out-button');
                purchaseButton.classList.add('quantity-required-button');
            }
            else
            {
                purchaseButton.disabled = false;
                purchaseButton.textContent = 'Purchase Tickets';
                purchaseButton.classList.remove('sold-out-button');
                purchaseButton.classList.remove('quantity-required-button');
            }
        }

        // Ask the server if the code is good then update the total
        async function applyDiscount() 
        {
            const code = discountInput.value.trim();

            try 
            {
                const response = await fetch('@Url.Action("Check", "Discount")?code=' + encodeURIComponent(code));
                const result = await response.json();

                discountMessage.innerText = result.message;

                if (result.isValid) 
                {
                    percentOff = result.percentOff;
                    appliedDiscountInput.value = code;
                    discountMessage.classList.remove('discount-error');
                    discountMessage.classList.add('discount-success');
                }
                else 
                {
                    percentOff = 0;
                    appliedDiscountInput.value = "";
                    discountMessage.classList.remove('discount-success');
                    discountMessage.classList.add('discount-error');
                }
            }
            catch 
            {
                percentOff = 0;
                appliedDiscountInput.value = "";
                discountMessage.innerText = "Couldn't check that code right now. Please try again.";
                discountMessage.classList.remove('discount-success');
                discountMessage.classList.add('discount-error');
            }

            calculateTotal();
        }

        // Prevents users from typing harmful factors
        quantityInput.addEventListener('keydown', function (event)
        {
            if (['-', '.', '+', 'e', 'E'].includes(event.key))
            {
                event.preventDefault();
            }
        });

        quantityInput.addEventListener('input', calculateTotal);
        vipCheckbox.addEventListener('change', calculateTotal);
        fastTrackCheckbox.addEventListener('change', calculateTotal);
        applyDiscountButton.addEventListener('click', applyDiscount);

        // Editing the code will remove the discount until they click apply again
        discountInput.addEventListener('input', function ()
        {
            if (percentOff > 0)
            {
                percentOff = 0;
                appliedDiscountInput.value = "";
                discountMessage.innerText = "";
                calculateTotal();
            }

        });

        calculateTotal();

    </script>
}