@model EventTicketFlow.Models.Event

@{
    ViewData["Title"] = Model.EventName;

    // Get TicketType record passed from the controller
    var ticketType = ViewBag.TicketType as TicketType;
    int ticketsSold = ViewBag.TicketsSold ?? 0;
    int ticketsRemaining = ViewBag.TicketsRemaining ?? 0;
}

@section Styles
{
    <link rel="stylesheet"href="~/css/event-details.css"asp-append-version="true" />
}

<!-- Event header -->

<div class="event-details-page">

    <div class="page-links">
        <a asp-action="Index">← Back to Events</a>
    </div>

    <div class="event-header">

        <h1>@Model.EventName</h1>

        <div class="event-date-range">
            Event Start @Model.OpenDate.ToString("MMMM dd, yyyy h:mm tt")
            &nbsp;&nbsp;|&nbsp;&nbsp; 
            Event End @Model.CloseDate.ToString("MMMM dd, yyyy h:mm tt")
        </div>

    </div>

    <div class="event-hero">
        <div class="event-image-placeholder">Event Image</div>
    </div>

    <div class="event-details-grid">

        <!-- Left Side -->

        <section class="event-information">

            <h2>Event Description</h2>

            <p>@Model.EventDescription</p>

            <hr />

            <h3>Additional Information</h3>

            <div class="detail-row">
                <span class="detail-label">Maximum Capacity</span>
                <span>@Model.MaxTickets</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Tickets Sold</span>
                <span>@ticketsSold</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Tickets Remaining</span>
                <span>@ticketsRemaining</span>
            </div>

        </section>

        <!-- Right Side -->

        <aside class="ticket-panel">

            <h2>Tickets</h2>

            <div class="ticket-option">

                <p class="ticket-option-title">Quantity</p>

                <input id="quantity" class="ticket-price" type="number" min="0" max="@ticketsRemaining" value="0" />

            </div>

            <div class="ticket-option">
                <p class="ticket-option-title">General Admission</p>
                <p class="ticket-price">@ticketType?.GeneralPrice.ToString("C")</p>
            </div>

            <div class="ticket-option">
                <input type="checkbox"id="vipCheckbox" />

                <p class="ticket-option-title">VIP Access</p>
                <p class="ticket-price">(+@ticketType?.VipPrice.ToString("C"))</p>
            </div>

            <div class="ticket-option">
                <input type="checkbox" id="fastTrackCheckbox" />
                <p class ="ticket-option-title">Fast Track</p>
                <p class="ticket-price">(+@ticketType?.FastTrackPrice.ToString("C"))</p>
            </div>

            <hr />

            <div class="ticket-option">
                <span>Total Cost</span>
                <span id="totalCost">@ticketType?.GeneralPrice.ToString("C")</span>

            </div>

                <button id="purchaseButton" class="purchase-button">Purchase Tickets</button>

        </aside>

    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("EventManager"))
    {
        <div class="page-links"><a asp-action="Edit"asp-route-id="@Model.Id">Edit Event</a>
        </div>
    }

</div>

@section Scripts
{
    <script>

        // map variables from view
        const quantityInput = document.getElementById('quantity');
        const vipCheckbox = document.getElementById('vipCheckbox');
        const fastTrackCheckbox = document.getElementById('fastTrackCheckbox');
        const totalCost = document.getElementById('totalCost');
        const purchaseButton = document.getElementById('purchaseButton');
        const ticketsRemaining = @ticketsRemaining;

        // map prices for each ticket option
        const basePrice = @((ticketType?.GeneralPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const vipPrice = @((ticketType?.VipPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const fastTrackPrice = @((ticketType?.FastTrackPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));

        // fucntion to calculate total price, track quantity that can be purchased, and adjust purchase button state
        function calculateTotal()
        {
            let quantity = parseInt(quantityInput.value) || 0;

            // Prevent quantity from going higher than available when typed
            if (quantity > ticketsRemaining) 
            {
                quantity = ticketsRemaining;
                quantityInput.value = ticketsRemaining;
            }

            // Calculate total based on selections
            let ticketPrice = basePrice;

            if (vipCheckbox.checked)
            {
                ticketPrice += vipPrice;
            }

            if (fastTrackCheckbox.checked)
            {
                ticketPrice += fastTrackPrice;
            }

            let total = ticketPrice * quantity;

            totalCost.innerText = '$' + total.toFixed(2);

            // Purchase button state management
            if (ticketsRemaining <= 0)
            {
                purchaseButton.disabled = true;
                purchaseButton.textContent = 'Sold Out';
                purchaseButton?.classList.add('sold-out-button');
                purchaseButton.classList.remove('quantity-required-button');
            }
            else if (quantity < 1)
            {
                purchaseButton.disabled = true;
                purchaseButton.textContent = 'Select Quantity';
                purchaseButton.classList.remove('sold-out-button');
                purchaseButton.classList.add('quantity-required-button');
            }
            else
            {
                purchaseButton.disabled = false;
                purchaseButton.textContent = 'Purchase Tickets';
                purchaseButton.classList.remove('sold-out-button');
                purchaseButton.classList.remove('quantity-required-button');
            }
        }

        quantityInput.addEventListener('input', calculateTotal);
        vipCheckbox.addEventListener('change', calculateTotal);
        fastTrackCheckbox.addEventListener('change', calculateTotal);

        calculateTotal();

    </script>
}