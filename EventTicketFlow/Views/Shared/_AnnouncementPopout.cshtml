@{
    var errorMessage = TempData["ErrorMessage"] as string;
    var successMessage = TempData["SuccessMessage"] as string;
    var warningMessage = TempData["WarningMessage"] as string;
}

<div class="announcement-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-popout alert-danger" role="alert">
            <span><strong>Error:</strong> @errorMessage</span>
            <button type="button" class="alert-close" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert-popout alert-success" role="alert">
            <span><strong>Success:</strong> @successMessage</span>
            <button type="button" class="alert-close" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(warningMessage))
    {
        <div class="alert-popout alert-warning" role="alert">
            <span><strong>Notice:</strong> @warningMessage</span>
            <button type="button" class="alert-close" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }
</div>